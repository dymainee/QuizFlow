@using QuizFlow.DTO
@model LoginDto
@*

*@

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="p-4 p-md-5">
                    <div class="text-center mb4">
                        <h2 class="fw-bold text-primary">Login</h2>
                    </div>
                    <form asp-controller="User" asp-action="Login" method="post">
                        <div class="form-floating mb-3">
                            <input asp-for="Email" type="email" class="form-control" placeholder="name@example.com" required />
                            <label asp-for="Email">gmail</label>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Password" type="password" class="form-control" placeholder="Password" required />
                            <label asp-for="Password">Password</label>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="text-center">
                            <button type="submit" class="btn btn-primary btn-lg rounded-3">Submit</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
