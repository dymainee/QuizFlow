@using QuizFlow.DTO
@model RegisterTeacherDto
@*form-control — это готовый CSS-класс из фреймворка Bootstrap, 
    который отвечает за внешний вид и верстку полей ввода (<input>, <textarea>, <select>).
    *@

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="p-4 p-md-5">
                    <div class="text-center mb4">
                        <h2 class="fw-bold text-primary">Teacher Registration</h2>
                    </div>
                    <form asp-controller="User" asp-action="RegisterTeacher" method="post">
                        <div class="form-floating mb-3">
                            <input asp-for="Username" class="form-control" placeholder="Username" required />
                            <label asp-for="Username">Username</label>
                            <span asp-validation-for="Username" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Name" class="form-control" placeholder="Name" required />
                            <label asp-for="Name">Name</label>
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Surname" class="form-control" placeholder="Surname" required />
                            <label asp-for="Surname">Surname</label>
                            <span asp-validation-for="Surname" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Email" type="email" class="form-control" placeholder="name@example.com" required />
                            <label asp-for="Email">gmail</label>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Password" type="password" class="form-control" placeholder="Password" required />
                            <label asp-for="Password">Password</label>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="DateOfBirth" type="date" class="form-control" placeholder="date of birth" required />
                            <label asp-for="DateOfBirth">DateOfBirth</label>
                            <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="WorkPlace" class="form-control" placeholder="Work Place" />
                            <label asp-for="WorkPlace">School/Uni</label>
                            <span asp-validation-for="WorkPlace" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mb-4">
                            <input asp-for="Specialization" class="form-control" placeholder="Specialization" />
                            <label asp-for="Specialization">Math,History</label>
                            <span asp-validation-for="Specialization" class="text-danger small"></span>
                        </div>

                        <div class="text-center">
                            <button type="submit" class="btn btn-primary btn-lg rounded-3">Submit</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>