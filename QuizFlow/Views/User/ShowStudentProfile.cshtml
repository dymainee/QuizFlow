@using QuizFlow.DTO
@model StudentProfileDTO
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <h1 class="h3 fw-bold text-dark m-0">Student Profile</h1>
    </div>

    <div class="row g-4 justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="p-4 bg-light border rounded-3 shadow-sm">
                <h4 class="fw-bold mb-3 text-center">Edit Profile</h4>

                <form asp-controller="User" asp-action="ShowStudentProfile" method="post">

                    <div class="form-floating mb-3">
                        <input asp-for="Name" class="form-control" placeholder="Name" required />
                        <label asp-for="Name">Name</label>
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Surname" class="form-control" placeholder="Surname" required />
                        <label asp-for="Surname">Surname</label>
                        <span asp-validation-for="Surname" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Email" class="form-control" placeholder="Email" />
                        <label asp-for="Email">Email</label>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Password" type="password" class="form-control" placeholder="Password" />
                        <label asp-for="Password">Password</label>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="DateOfBirth" type="date" class="form-control" />
                        <label asp-for="DateOfBirth">Date of Birth</label>
                        <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                    </div>


                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary w-50 py-2">Save Changes</button>

                        <a asp-controller="User" asp-action="ReturnToMenu"
                           class="btn btn-primary w-50 py-2 d-inline-flex align-items-center justify-content-center">
                            Return back
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>