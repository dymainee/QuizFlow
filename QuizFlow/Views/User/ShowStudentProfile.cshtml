@using QuizFlow.DTO
@model StudentProfileDTO
@using QuizFlow.Models.Enums
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <h1 class="h3 fw-bold text-dark m-0">Student Profile</h1>
        <span class="badge bg-primary rounded-pill px-3 py-2">
            Total Games Played: @(Model.userGames?.Count)
        </span>
    </div>
    <div class="row g-4">
        <div class="col-12 col-lg-5">
            <div class="p-4 bg-light border rounded-3 sticky-top">
                <form asp-controller="User" asp-action="ShowStudentProfile" method="post">

                    <div class="form-floating mb-3">
                        <input asp-for="Name" class="form-control" placeholder="Name" required />
                        <label asp-for="Name">Name</label>
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Surname" class="form-control" placeholder="Surname" required />
                        <label asp-for="Surname">Surname</label>
                        <span asp-validation-for="Surname" class="text-danger small"></span>
                    </div>
                    <div class="form-floating mb-3">
                        <input asp-for="Email" class="form-control" placeholder="Email" />
                        <label asp-for="Email">Email</label>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Password" type="password" class="form-control" placeholder="Password" />
                        <label asp-for="Password">Password</label>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="DateOfBirth" type="date" class="form-control" />
                        <label asp-for="DateOfBirth">Date of Birth</label>
                        <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 rounded-3 fw-bold">
                        Apply
                    </button>
                </form>
            </div>
        </div>
        <div class="col-12 col-lg-7">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="fw-bold m-0">List of Quizzes</h4>

                <a asp-controller="User"
                   asp-action="ReturnToMenu"
                   class="btn btn-primary btn-sm d-flex align-items-center gap-1">
                    Return To Menu
                </a>
            </div>

            <div class="p-3 border rounded-3 bg-white shadow-sm mb-4">
                <form asp-controller="User" asp-action="ShowStudentProfile" method="get">
                    <h5 class="fw-bold text-primary mb-3">Search & Filtering</h5>

                    <div class="row g-2">
                        <div class="col-12 col-md-6">
                            <input type="text"
                                   asp-for="title_filter"
                                   class="form-control rounded-3"
                                   placeholder="Search by title..." />
                        </div>

                        <div class="col-12 col-md-6">
                            <select name="selectedSort" class="form-select rounded-3">
                                <option value="Date_Desc" selected="@(Model.universalDTO.sortField == "Date" && Model.universalDTO.sortOrder == SortOrder.Descending)">
                                    Recently played
                                </option>
                                <option value="Date_Asc" selected="@(Model.universalDTO.sortField == "Date" && Model.universalDTO.sortOrder == SortOrder.Ascending)">
                                    Oldest played
                                </option>
                                <option value="Title_Asc" selected="@(Model.universalDTO.sortField == "Title" && Model.universalDTO.sortOrder == SortOrder.Ascending)">
                                    Title: A-Z
                                </option>
                                <option value="Title_Desc" selected="@(Model.universalDTO.sortField == "Title" && Model.universalDTO.sortOrder == SortOrder.Descending)">
                                    Title: Z-A
                                </option>
                            </select>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 mt-3 rounded-3 fw-bold">
                        Apply
                    </button>
                </form>
            </div>

            @if (Model.userGames.Any())
            {
                <div class="row g-3">
                    @foreach (var game in Model.userGames)
                    {
                        <div class="col-12 col-md-6">
                            <div class="card border rounded-3 h-100">
                                <div class="card-body p-3 d-flex flex-column justify-content-between">

                                    <div>
                                        <h5 class="card-title fw-bold mb-2" title="@game.QuizTitle">
                                            @game.QuizTitle
                                        </h5>

                                        <div class="d-flex align-items-center justify-content-between my-2">
                                            <span class="badge bg-success">
                                                Score: @game.Score
                                            </span>
                                            <small class="text-secondary">
                                                @(game.FinishedAt?.ToString("dd.MM.yyyy"))
                                            </small>
                                        </div>
                                    </div>

                                    <div class="mt-3 pt-2 border-top">
                                        <a asp-controller="QuizSession"
                                           asp-action="GetQuizResult"
                                           asp-route-sessionId="@game.SessionId"
                                           class="btn btn-outline-primary btn-sm w-100">
                                            View Results
                                        </a>
                                    </div>

                                </div>
                            </div>
                        </div>
                    }
                </div>

                int totalPages = (int)Math.Ceiling((double)Model.universalDTO.TotalCount / Model.universalDTO.PageSize);

                @if (totalPages > 1)
                {
                    <div class="row mt-4">
                        <div class="col-12 d-flex justify-content-end align-items-center gap-2">
                            @if (Model.universalDTO.PageNumber > 1)
                            {
                                <a asp-action="ShowStudentProfile"
                                   asp-route-PageNumber="@(Model.universalDTO.PageNumber - 1)"
                                   asp-route-sortOrder="@Model.universalDTO.sortOrder"
                                   asp-route-sortField="@Model.universalDTO.sortField"
                                   asp-route-title_filter="@Model.title_filter"
                                   class="btn btn-outline-secondary fs-5 px-3">
                                    &laquo;
                                </a>
                            }
                            @for (int page_n = 1; page_n <= totalPages; page_n++)

                            {
                                <a asp-action="ShowStudentProfile"
                                   asp-route-PageNumber="@page_n"
                                   asp-route-sortOrder="@Model.universalDTO.sortOrder"
                                   asp-route-sortField="@Model.universalDTO.sortField"
                                   asp-route-title_filter="@Model.title_filter" class="fs-5 px-3">

                                    @page_n
                                </a>
                            }
                            @if (Model.universalDTO.PageNumber < totalPages)
                            {
                                <a asp-action="ShowStudentProfile"
                                   asp-route-PageNumber="@(Model.universalDTO.PageNumber + 1)"
                                   asp-route-sortOrder="@Model.universalDTO.sortOrder"
                                   asp-route-sortField="@Model.universalDTO.sortField"
                                   asp-route-title_filter="@Model.title_filter"
                                   class="btn btn-outline-secondary fs-5 px-3">
                                    &raquo;
                                </a>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="alert alert-info text-center py-4 rounded-3 border">
                    No games was found. Reset filters or play a new game.
                </div>
            }
        </div>

    </div>
</div>

