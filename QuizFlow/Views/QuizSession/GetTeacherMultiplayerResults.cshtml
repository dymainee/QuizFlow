@using QuizFlow.DTO
@using QuizFlow.Models.Enums
@model MultiplayerGamesResultsDTO

<div class="col-12 col-lg-8 mx-auto">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-bold m-0">List of Quizzes</h4>

        <a asp-controller="User"
           asp-action="ReturnToMenu"
           class="btn btn-primary btn-sm d-flex align-items-center gap-1">
            Return To Menu
        </a>
    </div>

    <div class="p-3 border rounded-3 bg-white shadow-sm mb-4">
        <form asp-controller="QuizSession" asp-action="GetTeacherMultiplayerResults" method="get">
            <h5 class="fw-bold text-primary mb-3">Search & Filtering</h5>

            <div class="row g-2">
                <div class="col-12 col-md-6">
                    <input type="text"
                           asp-for="title_filter"
                           class="form-control rounded-3"
                           placeholder="Search by title or group name..." />
                </div>

                <div class="col-12 col-md-6">
                    <select name="selectedSort" class="form-select rounded-3">
                        <option value="Date_Desc" selected="@(Model.universalDTO.sortField == "Date" && Model.universalDTO.sortOrder == SortOrder.Descending)">
                            Recently played
                        </option>
                        <option value="Date_Asc" selected="@(Model.universalDTO.sortField == "Date" && Model.universalDTO.sortOrder == SortOrder.Ascending)">
                            Oldest played
                        </option>
                        <option value="Group_Asc" selected="@(Model.universalDTO.sortField == "Group" && Model.universalDTO.sortOrder == SortOrder.Ascending)">
                            Group: A-Z
                        </option>
                        <option value="Group_Desc" selected="@(Model.universalDTO.sortField == "Group" && Model.universalDTO.sortOrder == SortOrder.Descending)">
                            Group: Z-A
                        </option>
                        <option value="Title_Asc" selected="@(Model.universalDTO.sortField == "Title" && Model.universalDTO.sortOrder == SortOrder.Ascending)">
                            Title: A-Z
                        </option>
                        <option value="Title_Desc" selected="@(Model.universalDTO.sortField == "Title" && Model.universalDTO.sortOrder == SortOrder.Descending)">
                            Title: Z-A
                        </option>
                    </select>
                </div>
            </div>

            <button type="submit" class="btn btn-primary w-100 mt-3 rounded-3 fw-bold">
                Apply
            </button>
        </form>
    </div>
@if (Model.userGames != null && Model.userGames.Any())
{
    <div class="row g-3">
        @foreach (var game in Model.userGames)
        {
            <div class="col-12 col-md-6">
                <div class="card border rounded-3 h-100">
                    <div class="card-body p-3 d-flex flex-column justify-content-between">

                        <div>
                            <h5 class="card-title fw-bold mb-2" title="@game.QuizTitle">
                                @game.QuizTitle
                            </h5>
                            <div class="d-flex flex-wrap align-items-center justify-content-between my-2 gap-2">
                                <div class="d-flex gap-1 align-items-center">
                                    <span class="badge bg-success">Score: @game.Score</span>
                                    <span class="badge bg-primary">@game.StudentName</span>
                                    <span class="badge bg-secondary">@(string.IsNullOrEmpty(game.GroupName) ? "WithoutGroup" : game.GroupName)</span>
                                </div>
                                <small class="text-secondary">
                                    @(game.FinishedAt?.ToString("dd.MM.yyyy"))
                                </small>
                            </div>
                        </div>

                        <div class="mt-3 pt-2 border-top">
                            <a asp-controller="QuizSession"
                               asp-action="GetQuizResult"
                               asp-route-sessionId="@game.SessionId"
                               class="btn btn-outline-primary btn-sm w-100 mb-2">
                                View Results
                            </a>
                            <form asp-controller="QuizSession"
                                  asp-action="DeleteSessionQuizInTeacher"
                                  asp-route-id="@game.SessionId"
                                  method="post"
                                  class="w-100 m-0">
                                <button type="submit"
                                        class="btn btn-outline-danger btn-sm w-100 d-flex align-items-center justify-content-center gap-1">
                                    Delete
                                </button>
                            </form>
                        </div>

                    </div>
                </div>
            </div>
        }
    </div>

    
    int totalPages = (int)Math.Ceiling((double)Model.universalDTO.TotalCount / Model.universalDTO.PageSize);
    

    @if (totalPages > 1)
    {
        <div class="row mt-4">
            <div class="col-12 d-flex justify-content-end align-items-center gap-2">
                @if (Model.universalDTO.PageNumber > 1)
                {
                    <a asp-action="GetTeacherMultiplayerResults"
                       asp-route-PageNumber="@(Model.universalDTO.PageNumber - 1)"
                       asp-route-sortOrder="@Model.universalDTO.sortOrder"
                       asp-route-sortField="@Model.universalDTO.sortField"
                       asp-route-title_filter="@Model.title_filter"
                       class="btn btn-outline-secondary fs-5 px-3">
                        &laquo;
                    </a>
                }
                @for (int page_n = 1; page_n <= totalPages; page_n++)
                {
                        <a asp-action="GetTeacherMultiplayerResults"
                       asp-route-PageNumber="@page_n"
                       asp-route-sortOrder="@Model.universalDTO.sortOrder"
                       asp-route-sortField="@Model.universalDTO.sortField"
                       asp-route-title_filter="@Model.title_filter" class="fs-5 px-3">

                        @page_n
                    </a>
                }
                @if (Model.universalDTO.PageNumber < totalPages)
                {
                    <a asp-action="GetTeacherMultiplayerResults"
                       asp-route-PageNumber="@(Model.universalDTO.PageNumber + 1)"
                       asp-route-sortOrder="@Model.universalDTO.sortOrder"
                       asp-route-sortField="@Model.universalDTO.sortField"
                       asp-route-title_filter="@Model.title_filter"
                       class="btn btn-outline-secondary fs-5 px-3">
                        &raquo;
                    </a>
                }
            </div>
        </div>
    }
}
else
{
    <div class="alert alert-info text-center py-4 rounded-3 border">
        No games were found. Reset filters or wait for students to complete the quiz.
    </div>
}