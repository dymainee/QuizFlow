@using QuizFlow.DTO
@model QuizSessionResultDTO
<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8">
            <div class="card shadow-lg border-0 rounded-4 mb-4 text-center">
                <div class="card-body p-4 p-md-5">
                    <h2 class="fw-bold mb-2">@Model.QuizTitle</h2>
                    <p class="text-muted mb-4">Test Result</p>
                    <div class="display-3 fw-bold mb-2">
                        @Model.Score%
                    </div>

                    <p class="fs-5 text-secondary mb-4">
                        Correct Answers: <strong>@Model.CorrectAnswers</strong> out <strong>@Model.TotalQuestions</strong>
                    </p>

                    <a asp-controller="Menu" asp-action="ShowAll" class="btn btn-primary btn-lg rounded-3 px-4">
                        Back To menu
                    </a>
                </div>
            </div>
            <h4 class="fw-bold mb-3 px-2">Question</h4>

            @foreach (var question in Model.Questions)
            {
                <div class="card shadow-sm border-0 rounded-4 mb-3">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <h5 class="fw-bold">@question.QuestionTitle</h5>
                            @if (question.IsCorrect)
                            {
                                <span class="badge bg-success-subtle text-success border border-success rounded-pill px-3 py-1">
                                   Correct
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger rounded-pill px-3 py-1">
                                    False
                                </span>
                            }
                        </div>

                        <p class="text-muted small mb-3">@question.QuestionText</p>

                        <div class="d-flex flex-column gap-2">
                            @foreach (var option in question.Options)
                            {
                                <div class="p-2 mb-2 border rounded d-flex justify-content-between align-items-center">
                                        @option.Text

                                    <div>
                                        @if (option.IsCorrect)
                                        {
                                            <span class="badge bg-success">Correct</span>
                                        }
                                        @if (option.IsSelected && !option.IsCorrect)
                                        {
                                            <span class="badge bg-danger">Your answer</span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>

                    </div>
                </div>
            }

        </div>
    </div>
</div>
