@using QuizFlow.DTO
@model QuestionPageDTO
<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-body p-4 p-md-5">

                    <div class="text-center mb-4">
                        <span class="badge bg-primary rounded-pill px-3 py-2 fs-6">
                            Question @Model.CurrentQuestionNumber out of @Model.TotalQuestions
                        </span>
                    </div>

                    <h3 class="fw-bold text-center mb-2">@Model.QuestionTitle</h3>
                    <p class="text-muted text-center mb-4">@Model.QuestionText</p>

                    @if (!string.IsNullOrEmpty(Model.Image))
                    {
                        <div class="text-center mb-4">
                            <img src="@Model.Image"
                                 class="img-fluid rounded-3 shadow-sm"
                                 style="max-height: 250px; object-fit: contain;" />
                        </div>
                    }
                    else
                    {
                        <div class="text-center mb-4">
                            <img src="/Images/quizzes/default-quiz.jpg"
                                 class="img-fluid rounded-3 shadow-sm"
                                 style="max-height: 250px; object-fit: contain;" />
                        </div>
                    }

                    <form asp-controller="QuizSession" asp-action="GetQuestion" method="post">
                        <input type="hidden" name="sessionId" value="@Model.SessionId" />
                        <input type="hidden" name="questionId" value="@Model.QuestionId" />
                        <input type="hidden" name="questionNumber" value="@Model.CurrentQuestionNumber" />
                        <div class="mb-4 px-3">
                            @foreach (var option in Model.Options)
                            {
                                <div class="form-check custom-option-card mb-2 p-3 border rounded-3 text-center mx-auto" style="max-width: 400px;">
                                    <input class="form-check-input ms-1"
                                           type="radio"
                                           name="selectedOptionId"
                                           id="option_@option.Id"
                                           value="@option.Id"
                                           @(option.Id == Model.SelectedOptionId ? "checked" : "")
                                           required />

                                    <label class="form-check-label w-100 ms-2 cursor-pointer" for="option_@option.Id">
                                        @option.Text
                                    </label>
                                </div>
                            }
                        </div>
                        <div class="d-flex flex-column align-items-center gap-2 mt-4">
                            <button type="submit" class="btn btn-primary btn-lg rounded-3 w-50">
                                @(Model.CurrentQuestionNumber == Model.TotalQuestions ? "Finish Test" : "Next Question")
                            </button>

                            @if (Model.CurrentQuestionNumber > 1)
                            {
                                <a asp-controller="QuizSession"
                                   asp-action="GetQuestion"
                                   asp-route-sessionId="@Model.SessionId"
                                   asp-route-questionNumber="@(Model.CurrentQuestionNumber - 1)"
                                   class="btn btn-outline-secondary rounded-3 w-50">
                                    Previous Question
                                </a>
                            }
                        </div>

                    </form>

                </div> 

            </div>
        </div>
    </div>
</div>