@model QuizMultiPlayerLobby

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="p-4 p-md-5">
                    <div class="text-center mb-4">
                        <h2 class="fw-bold text-primary">Create a Lobby</h2>
                    </div>

                    <form asp-controller="QuizSession" asp-action="LobbyHost" method="post">
                        <input asp-for="QuizId" type="hidden" />

                        <div class="form-floating mb-3">
                            <input asp-for="GroupName" class="form-control" placeholder="Group/ Class" required />
                            <label asp-for="GroupName">Name of the Group</label>
                            <span asp-validation-for="GroupName" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100">
                            Generate a Qr code
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>